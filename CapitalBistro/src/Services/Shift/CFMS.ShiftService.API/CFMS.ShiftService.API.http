@ShiftAPI = https://localhost:7290
@Token = paste_your_jwt_token_here_with_role_Manager
@TokenStaff = paste_your_jwt_token_here_with_role_Staff

# 1. TẠO CẤU HÌNH CA LÀM VIỆC (ROLE: MANAGER)
POST {{ShiftAPI}}/api/shifts
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "shiftName": "Morning Shift",
  "startTime": "07:00:00",
  "endTime": "15:00:00",
  "requiredStaffCount": 5
}

###

# 2. XEM DANH SÁCH CA LÀM CỦA CHI NHÁNH (Manager / Staff của Franchise đó)
GET {{ShiftAPI}}/api/shifts
Authorization: Bearer {{Token}}

###

# 3. PHÂN CÔNG LỊCH (ROLE: MANAGER)
# Copy Id của Shift tạo ở bước 1 vào ShiftConfigId
POST {{ShiftAPI}}/api/shifts/assign
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "shiftConfigId": "00000000-0000-0000-0000-000000000000",
  "workingDate": "2026-05-10",
  "userIds": [
    "11111111-1111-1111-1111-111111111111",
    "22222222-2222-2222-2222-222222222222"
  ]
}

###

# 4. XEM LỊCH CÁ NHÂN (ROLE: STAFF)
# Cần dùng TokenStaff để API tự trích xuất UserId
GET {{ShiftAPI}}/api/shifts/my-schedule?fromDate=2026-05-01&toDate=2026-05-31
Authorization: Bearer {{TokenStaff}}
