{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/products/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/orders/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/api/customers/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "shift-route": {
        "ClusterId": "shift-cluster",
        "Match": { "Path": "/api/shifts/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/api/deliveries/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "promotion-route": {
        "ClusterId": "promotion-cluster",
        "Match": { "Path": "/api/promotions/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": { "Path": "/api/reports/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "franchise-route": {
        "ClusterId": "franchise-cluster",
        "Match": { "Path": "/api/franchises/{**remainder}" },
        "RateLimiterPolicy": "fixed-window"
      },
      "swagger-auth": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/swagger/auth/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/auth" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-product": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/swagger/product/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/product" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-inventory": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/swagger/inventory/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/inventory" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-order": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/swagger/order/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/order" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-customer": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/swagger/customer/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/customer" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-shift": {
        "ClusterId": "shift-cluster",
        "Match": { "Path": "/swagger/shift/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/shift" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-delivery": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/swagger/delivery/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/delivery" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-payment": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/swagger/payment/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/payment" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-promotion": {
        "ClusterId": "promotion-cluster",
        "Match": { "Path": "/swagger/promotion/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/promotion" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-reporting": {
        "ClusterId": "reporting-cluster",
        "Match": { "Path": "/swagger/reporting/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/reporting" }, { "PathPrefix": "/swagger" } ]
      },
      "swagger-franchise": {
        "ClusterId": "franchise-cluster",
        "Match": { "Path": "/swagger/franchise/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/franchise" }, { "PathPrefix": "/swagger" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "destination1": { "Address": "http://authservice:8080" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "product-cluster": {
        "Destinations": { "destination1": { "Address": "http://productservice:8080" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": { "destination1": { "Address": "http://inventoryservice:8080" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "order-cluster": {
        "Destinations": { "destination1": { "Address": "http://orderservice:8080" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "customer-cluster": {
        "Destinations": { "destination1": { "Address": "http://customerservice:8080" } }
      },
      "shift-cluster": {
        "Destinations": { "destination1": { "Address": "http://shiftservice:8080" } }
      },
      "delivery-cluster": {
        "Destinations": { "destination1": { "Address": "http://deliveryservice:8080" } }
      },
      "payment-cluster": {
        "Destinations": { "destination1": { "Address": "http://paymentservice:8080" } }
      },
      "promotion-cluster": {
        "Destinations": { "destination1": { "Address": "http://promotionservice:8080" } }
      },
      "reporting-cluster": {
        "Destinations": { "destination1": { "Address": "http://reportingservice:8080" } }
      },
      "franchise-cluster": {
        "Destinations": { "destination1": { "Address": "http://franchiseservice:8080" } }
      }
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Product Service",
        "Uri": "http://productservice:8080/health"
      },
      {
        "Name": "Order Service",
        "Uri": "http://orderservice:8080/health"
      }
    ],
    "EvaluationTimeInSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
